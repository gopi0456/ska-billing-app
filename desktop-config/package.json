{
  "name": "ska-billing-desktop",
  "version": "1.0.0",
  "description": "SK Aayurveda Billing Desktop Client (Win7 Compatible)",
  "main": "main.js",
  "scripts": {
    "build:win7": "electron-builder --win portable --ia32"
  },
  "devDependencies": {
    "electron": "22.3.27",
    "electron-builder": "^24.9.1"
  },
  "build": {
    "appId": "org.keva.ska.billing.desktop",
    "productName": "SK Aayurveda Billing",
    "directories": {
      "output": "../dist-desktop"
    },
    "files": [
      "main.js",
      "../../www/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "ia32"
          ]
        }
      ]
    },
    "publish": null
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/gopi0456/ska-billing-app.git"
  },
  "author": "KaiPo Keva Team"
}