{
  "name": "ska-billing-desktop",
  "version": "1.0.0",
  "description": "SK Aayurveda Billing Desktop Client (Win7 Compatible)",
  "main": "main.js",
  "scripts": {
    "build:win7": "electron-builder --win --ia32"
  },
  "devDependencies": {
    "electron": "21.4.4",
    "electron-builder": "23.6.0"
  },
  "build": {
    "appId": "org.keva.ska.billing.desktop",
    "productName": "SK Aayurveda Billing",
    "asar": false,
    "directories": {
      "output": "../dist-desktop"
    },
    "files": [
      "main.js",
      "desktop.css",
      "dist-web/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["ia32"]
        },
        {
          "target": "zip",
          "arch": ["ia32"]
        }
      ]
    },
    "publish": null,
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SK Aayurveda Billing",
      "artifactName": "SKA-Billing-Setup-${version}.exe",
      "deleteAppDataOnUninstall": false
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/gopi0456/ska-billing-app.git"
  },
  "author": "KaiPo Keva Team"
}
