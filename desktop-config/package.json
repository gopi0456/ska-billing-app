{
  "name": "ska-billing-desktop",
  "version": "1.0.0",
  "description": "SK Aayurveda Billing Desktop Client (Win7 Compatible)",
  "main": "main.js",
  "scripts": {
    "build:win7": "electron-builder --win portable --ia32"
  },
  "devDependencies": {
    "electron": "28.3.3",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "org.keva.ska.billing.desktop",
    "productName": "SK Aayurveda Billing",
    "directories": {
      "output": "../dist-desktop"
    },
    "files": [
      "main.js",
      "../../www/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": ["ia32"]
        }
      ]
    }
  }
}
