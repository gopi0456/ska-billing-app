<body>
<div class="header"><h2>🕉️ SK AAYURVEDA</h2><div class="subtitle">KEVA SUPER STOCK POINT</div></div>
<div class="tabs">
<button class="tab-btn active" data-tab="billing"><span class="tab-icon">🧾</span>Billing</button>
<button class="tab-btn" data-tab="history"><span class="tab-icon">📊</span>History</button>
<button class="tab-btn" data-tab="requirement"><span class="tab-icon">📦</span>Requirement</button>
<button class="tab-btn" data-tab="settings"><span class="tab-icon">⚙️</span>Settings</button>
</div>
<div class="container">
<div id="billing" class="tab-content active">
<div class="card">
<h3><span class="icon">👤</span> Customer Details</h3>
<div id="customer-type-display" style="display:none;"><span class="customer-type-badge" id="customer-type-badge"></span></div>
<div class="search-dropdown" id="cust-dropdown"><input type="text" id="cust-name" placeholder="🔍 Search Customer Name" autocomplete="off"><div class="dropdown-list" id="cust-list"></div></div>
<input type="tel" id="cust-mobile" placeholder="📱 Mobile Number (10 digits)" maxlength="10" inputmode="numeric" pattern="[0-9]*" oninput="this.value=this.value.replace(/[^0-9]/g,'').slice(0,10)">
<div class="update-mobile-wrap" id="bill-update-wrap" onclick="toggleUpdateMobile('bill')"><input type="checkbox" id="bill-update-mobile" onclick="event.stopPropagation();handleUpdateMobileCheck('bill',this)"><label for="bill-update-mobile" onclick="event.stopPropagation()">🔄 Update Mobile Number</label></div>
<div class="price-selection">
<label><input type="checkbox" id="show-mrp" checked onchange="updatePriceDisplay()"> 💲 MRP</label>
<label><input type="checkbox" id="show-sp" checked onchange="updatePriceDisplay()"> 🏷️ SP</label>
<label><input type="checkbox" id="show-bp" checked onchange="updatePriceDisplay()"> 💰 BP</label>
</div>
<div id="stockist-id-section"><div style="display:flex;gap:6px;align-items:start;"><div class="search-dropdown" id="stockist-id-dropdown" style="flex:1;margin-bottom:0;"><input type="text" id="stockist-id" placeholder="🏪 Stockist ID" autocomplete="off"><div class="dropdown-list" id="stockist-id-list"></div></div><button class="btn btn-share" style="width:auto;margin-top:0;padding:11px 12px;white-space:nowrap;" onclick="manualFetchStockistId()" title="Fetch from previous bills"><span class="btn-icon">🔄</span></button></div></div>
</div>
<div class="card">
<h3><span class="icon">🛒</span> Add Products</h3>
<div class="search-dropdown" id="prod-dropdown"><input type="text" id="prod-search" placeholder="🔍 Search Product" autocomplete="off"><div class="dropdown-list" id="prod-list"></div></div>
<div class="table-wrap"><table><thead><tr><th>ITEM</th><th class="col-mrp">MRP</th><th class="col-sp">SP</th><th class="col-bp">BP</th><th>QTY</th><th class="col-mrp">T.MRP</th><th class="col-sp">T.SP</th><th class="col-bp">T.BP</th><th>X</th></tr></thead><tbody id="cart-body"></tbody></table></div>
<div class="summary-grid" id="summary-grid"><div class="col-mrp">💲 Total MRP<span>Rs. <span id="tot-mrp">0.00</span></span></div><div class="col-sp">🏷️ Total SP<span>Rs. <span id="tot-sp">0.00</span></span></div><div class="col-bp">💰 Total BP<span><span id="tot-bp">0.00</span> BP</span></div></div>
<button class="btn btn-primary" onclick="saveBill()"><span class="btn-icon">💾</span> Save Bill</button>
</div>
</div>
<div id="history" class="tab-content">
<div class="card">
<div id="history-main-view"><h3><span class="icon">📊</span> Customer Bill History</h3><button class="btn btn-share" style="margin-bottom:10px;" onclick="showCustomerManagement()"><span class="btn-icon">👥</span> Manage Customers</button><input type="text" id="search-history" placeholder="🔍 Search Customer..." oninput="loadHistoryCustomers()"><div id="customer-list"></div></div>
<div id="customer-mgmt-view" style="display:none;"><button class="btn btn-back" onclick="hideCustomerManagement()"><span class="btn-icon">⬅️</span> Back to History</button><h3 style="margin-top:0;border-bottom:2px solid #3498db;padding-bottom:8px;">👥 Customer Management</h3><button class="btn btn-primary" style="margin-bottom:10px;" onclick="openAddCustomerModal()"><span class="btn-icon">➕</span> Add New Customer</button><input type="text" id="mgmt-search" placeholder="🔍 Search customer..." oninput="renderCustomerManagement()" style="margin-bottom:10px;"><div id="mgmt-customer-list"></div></div><div id="history-detail-view" style="display:none;"><button class="btn btn-back" onclick="goBackToCustomers()"><span class="btn-icon">⬅️</span> Back to Customers</button><h3 id="detail-cust-name" style="margin-top:0;border-bottom:2px solid #27ae60;padding-bottom:8px;"></h3><div class="section-title"><span class="s-icon">📅</span><h4>Monthly BP Summary</h4></div><select id="monthly-filter" class="monthly-filter" onchange="updateMonthlySummary()"><option value="current">📅 Current Month</option><option value="previous">⏮️ Previous Month</option><option value="last3">📊 Last 3 Months</option><option value="last6">📊 Last 6 Months</option><option value="lastyear">📅 Last Year</option><option value="thisyear">📅 This Year</option><option value="all" selected>📋 All Time</option></select>
<div style="display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:15px;">
<div style="background:linear-gradient(135deg,#fff3e0,#ffe0b2);padding:15px;border-radius:10px;text-align:center;border:2px solid #ff9800;">
<div style="font-size:0.75rem;color:#e65100;font-weight:600;">📊 <span id="left-box-label">Selected Period</span></div>
<div style="font-size:1.4rem;font-weight:700;color:#e65100;margin-top:5px;"><span id="left-box-value">0.00</span> BP</div>
</div>
<div style="background:linear-gradient(135deg,#e8f5e9,#c8e6c9);padding:15px;border-radius:10px;text-align:center;border:2px solid #4caf50;">
<div style="font-size:0.75rem;color:#2e7d32;font-weight:600;">📅 This Month</div>
<div style="font-size:1.4rem;font-weight:700;color:#2e7d32;margin-top:5px;"><span id="right-box-value">0.00</span> BP</div>
</div>
</div>
<div id="monthly-summary" class="month-grid"></div><div class="section-title"><span class="s-icon">🧾</span><h4>All Bills</h4></div><div id="detail-bill-list"></div></div>
</div>
</div>
<div id="requirement" class="tab-content">
<div class="card">
