<script>
const DB={isCapacitor:window.Capacitor!==undefined,sqlite:null,conn:null,data:JSON.parse(localStorage.getItem('ska_db')||'{"customers":[],"products":[],"bills":[],"bill_items":[],"requirements":[],"manual_products":[]}'),async init(){if(this.isCapacitor&&window.CapacitorSQLite){try{this.sqlite=new window.CapacitorSQLite.SQLiteConnection(window.CapacitorSQLite);this.conn=await this.sqlite.createConnection("ska_db",false,"no-encryption",1,false);await this.conn.open();await this.conn.execute(`CREATE TABLE IF NOT EXISTS customers (id INTEGER PRIMARY KEY AUTOINCREMENT, name TEXT, mobile TEXT, customer_type TEXT)`);await this.conn.execute(`CREATE TABLE IF NOT EXISTS products (id INTEGER PRIMARY KEY AUTOINCREMENT, item_name TEXT, mrp REAL, sp REAL, bp REAL)`);await this.conn.execute(`CREATE TABLE IF NOT EXISTS bills (id INTEGER PRIMARY KEY AUTOINCREMENT, bill_number TEXT, customer_id INTEGER, cust_name TEXT, cust_mobile TEXT, customer_type TEXT, date TEXT, total_mrp REAL, total_sp REAL, total_bp REAL, price_columns TEXT, bp_status TEXT, stockist_id TEXT, bp_done_date TEXT, bp_done_remarks TEXT)`);await this.conn.execute(`CREATE TABLE IF NOT EXISTS bill_items (id INTEGER PRIMARY KEY AUTOINCREMENT, bill_id INTEGER, item_name TEXT, mrp REAL, sp REAL, bp REAL, qty INTEGER, tot_mrp REAL, tot_sp REAL, tot_bp REAL)`);await this.conn.execute(`CREATE TABLE IF NOT EXISTS requirements (id INTEGER PRIMARY KEY AUTOINCREMENT, customer TEXT, mobile TEXT, customer_type TEXT, item_name TEXT, qty INTEGER, date TEXT)`);await this.conn.execute(`CREATE TABLE IF NOT EXISTS manual_products (id INTEGER PRIMARY KEY AUTOINCREMENT, item_name TEXT, mrp REAL, sp REAL, bp REAL)`);try{await this.conn.execute(`ALTER TABLE requirements ADD COLUMN customer_type TEXT`)}catch(e){}try{await this.conn.execute(`ALTER TABLE customers ADD COLUMN customer_type TEXT`)}catch(e){}try{await this.conn.execute(`ALTER TABLE bills ADD COLUMN bill_number TEXT`)}catch(e){}try{await this.conn.execute(`ALTER TABLE bills ADD COLUMN bp_status TEXT`)}catch(e){}try{await this.conn.execute(`ALTER TABLE bills ADD COLUMN stockist_id TEXT`)}catch(e){}try{await this.conn.execute(`ALTER TABLE bills ADD COLUMN bp_done_date TEXT`)}catch(e){}try{await this.conn.execute(`ALTER TABLE bills ADD COLUMN bp_done_remarks TEXT`)}catch(e){}try{const eb=await this.conn.query(`SELECT id FROM bills WHERE bill_number IS NULL OR bill_number = ''`);if(eb.values&&eb.values.length>0){for(let i=0;i<eb.values.length;i++){await this.conn.execute(`UPDATE bills SET bill_number = ?, bp_status = COALESCE(bp_status, 'pending') WHERE id = ?`,['SKAA'+String(i+1).padStart(4,'0'),eb.values[i].id])}}await this.conn.execute(`UPDATE bills SET bp_status = 'pending' WHERE bp_status IS NULL OR bp_status = ''`)}catch(e){}}catch(err){this.isCapacitor=false}}else{if(this.data.bills){let c=1;this.data.bills.forEach(b=>{if(!b.bill_number)b.bill_number='SKAA'+String(c++).padStart(4,'0');if(!b.bp_status)b.bp_status='pending'});localStorage.setItem('ska_db',JSON.stringify(this.data))}}if(!this.data.manual_products){this.data.manual_products=[];localStorage.setItem('ska_db',JSON.stringify(this.data))}},async query(t){if(this.isCapacitor&&this.conn){const r=await this.conn.query(`SELECT * FROM ${t}`);return r.values||[]}return this.data[t]||[]},async run(t,item){if(this.isCapacitor&&this.conn){const c=Object.keys(item),v=Object.values(item);const r=await this.conn.execute(`INSERT INTO ${t} (${c.join(',')}) VALUES (${c.map(()=>'?').join(',')})`,v);return r.changes.lastId}item.id=Date.now()+Math.random();this.data[t].push(item);localStorage.setItem('ska_db',JSON.stringify(this.data));return item.id},async clear(t){if(this.isCapacitor&&this.conn)await this.conn.execute(`DELETE FROM ${t}`);else{this.data[t]=[];localStorage.setItem('ska_db',JSON.stringify(this.data))}},async update(t,id,u){if(this.isCapacitor&&this.conn){const s=Object.keys(u).map(k=>`${k}=?`).join(',');await this.conn.execute(`UPDATE ${t} SET ${s} WHERE id=?`,[...Object.values(u),id])}else{const i=this.data[t].find(i=>i.id==id);if(i)Object.assign(i,u);localStorage.setItem('ska_db',JSON.stringify(this.data))}},async delete(t,id){if(this.isCapacitor&&this.conn)await this.conn.execute(`DELETE FROM ${t} WHERE id=?`,[id]);else{this.data[t]=this.data[t].filter(r=>r.id.toString()!==id.toString());localStorage.setItem('ska_db',JSON.stringify(this.data))}}};

async function generateBillNumber(){const bills=await DB.query('bills');let m=0;bills.forEach(b=>{if(b.bill_number&&b.bill_number.startsWith('SKAA')){const n=parseInt(b.bill_number.substring(4));if(!isNaN(n)&&n>m)m=n}});return 'SKAA'+String(m+1).padStart(4,'0')}
function getBillNum(b){return b.bill_number||('SKAA'+String(b.id).padStart(4,'0'))}
function cleanProductName(n,t){if(t==='stockist')return n;let c=n;c=c.replace(/\s*\(\s*(?:buy|get|offer|free|combo|pack|\d+\s*\+\s*\d+)[^)]*\)\s*/gi,' ');c=c.replace(/\s*(?:buy\s+\d+\s+get\s+\d+(?:\s+free)?|offer|combo\s+pack|value\s+pack|\d+\s*\+\s*\d+\s*(?:offer|free|pack)?|free\s+gift|special\s+offer)\s*/gi,' ');c=c.replace(/\s*-\s*(?:offer|combo|pack|free|buy\s+\d+|get\s+\d+)[^-]*$/gi,' ');c=c.replace(/\s*\|\s*(?:offer|combo|pack|free|buy|get)[^|]*$/gi,' ');c=c.replace(/\s*\[\s*(?:offer|combo|pack|free|buy|get)[^\]]*\]\s*/gi,' ');c=c.replace(/\s+/g,' ').trim();return c||n}

let dropdownCache={customers:[],products:[],stockists:[],lastUpdate:0};
let currentCustomerBills=[];

async function refreshDropdownCache(){const cs=await DB.query('customers'),pp=await DB.query('products'),mp=await DB.query('manual_products'),bills=await DB.query('bills'),merged=new Map();pp.forEach(p=>merged.set(p.item_name.toLowerCase(),{...p,source:'pdf'}));mp.forEach(p=>merged.set(p.item_name.toLowerCase(),{...p,source:'manual'}));const sm=new Map();bills.forEach(b=>{if(b.stockist_id&&b.customer_type==='stockist'&&!sm.has(b.stockist_id))sm.set(b.stockist_id,{id:b.stockist_id,customer:b.cust_name,mobile:b.cust_mobile})});dropdownCache={customers:cs.map(c=>({name:c.name,mobile:c.mobile||'',type:c.customer_type||'customer',detail:c.mobile?`${c.mobile} | ${(c.customer_type||'customer').toUpperCase()}`:(c.customer_type||'customer').toUpperCase()})),products:Array.from(merged.values()).map(p=>({name:p.item_name,detail:`MRP: ${p.mrp} | SP: ${p.sp} | BP: ${p.bp}`,source:p.source||'pdf'})),stockists:Array.from(sm.values()),lastUpdate:Date.now()}}

function getCustomerType(m,s,b){if(m&&s&&b)return'stockist';if(m&&b&&!s)return'distributor';return'customer'}

async function autoFetchStockistId(name,mobile){
if(!name||!name.trim())return '';
const bills=await DB.query('bills');
const cm=(mobile||'').replace(/\D/g,'');
const nameLower=name.toLowerCase().trim();
let matching=bills.filter(b=>{
const bn=(b.cust_name||'').toLowerCase().trim();
const bm=(b.cust_mobile||'').replace(/\D/g,'');
return bn===nameLower&&bm===cm&&b.stockist_id&&b.stockist_id.trim()!==''&&b.customer_type==='stockist'
});
if(matching.length>0){
const latest=matching.sort((a,b)=>new Date(b.date)-new Date(a.date))[0];
return latest.stockist_id
}
const cs=await DB.query('customers');
const cm2=cs.find(c=>c.name.toLowerCase().trim()===nameLower&&(c.mobile||'').replace(/\D/g,'')===cm&&c.customer_type==='stockist');
if(cm2){
const sb=bills.filter(b=>String(b.customer_id)===String(cm2.id)&&b.stockist_id&&b.stockist_id.trim()!==''&&b.customer_type==='stockist');
if(sb.length>0){return sb.sort((a,b)=>new Date(b.date)-new Date(a.date))[0].stockist_id}
}
return ''
}

function updatePriceDisplay(){const m=document.getElementById('show-mrp').checked,s=document.getElementById('show-sp').checked,b=document.getElementById('show-bp').checked;document.querySelectorAll('.col-mrp').forEach(el=>el.style.display=m?'':'none');document.querySelectorAll('.col-sp').forEach(el=>el.style.display=s?'':'none');document.querySelectorAll('.col-bp').forEach(el=>el.style.display=b?'':'none');const badge=document.getElementById('customer-type-badge'),display=document.getElementById('customer-type-display'),si=document.getElementById('stockist-id');if(document.getElementById('cust-name').value.trim()){const t=getCustomerType(m,s,b);badge.className=`customer-type-badge type-${t}`;badge.innerText=t.toUpperCase();display.style.display='block';if(t==='stockist'){si.disabled=false;si.placeholder='🏪 Stockist ID'}else{si.disabled=true;si.value='';si.placeholder='🏪 Stockist ID (Disabled)'}}else{display.style.display='none';si.disabled=true;si.value='';si.placeholder='🏪 Stockist ID (Disabled)'}renderCart()}

let billFromDD=false,reqFromDD=false,stockistFromDD=false;
const dropdownInitialized={};
function setupSearchDropdown(inputId,listId,dataKey,onSelect){if(dropdownInitialized[inputId])return;dropdownInitialized[inputId]=true;const input=document.getElementById(inputId),list=document.getElementById(listId);let dt;function rwd(){clearTimeout(dt);dt=setTimeout(()=>renderDD(),50)}input.addEventListener('focus',rwd);input.addEventListener('input',rwd);input.addEventListener('blur',()=>{setTimeout(()=>list.classList.remove('show'),200)});function renderDD(){let data;if(dataKey==='customers')data=dropdownCache.customers;else if(dataKey==='products')data=dropdownCache.products;else if(dataKey==='stockists')data=dropdownCache.stockists;else data=[];const f=input.value.toLowerCase(),filtered=data.filter(i=>{if(dataKey==='stockists')return i.id.toLowerCase().includes(f)||(i.customer&&i.customer.toLowerCase().includes(f));return i.name.toLowerCase().includes(f)||(i.detail&&i.detail.toLowerCase().includes(f))});if(dataKey==='customers'){list.innerHTML=filtered.length>0?filtered.slice(0,50).map(i=>`<div class="dropdown-item" onclick="${onSelect}('${i.name.replace(/'/g,"\\'")}','${(i.mobile||'').replace(/'/g,"\\'")}','${(i.type||'').replace(/'/g,"\\'")}','${(i.detail||'').replace(/'/g,"\\'")}','')"><div class="item-name">${i.name}${i.mobile?`<span class="item-mobile">📱 ${i.mobile}</span>`:''}<span class="customer-type-badge type-${i.type||'customer'}" style="font-size:0.6rem;padding:1px 6px;margin-left:4px;margin-bottom:0;">${(i.type||'customer').toUpperCase()}</span></div></div>`).join(''):'<div class="dropdown-item" style="color:#999;">No matches found</div>'}else if(dataKey==='stockists'){list.innerHTML=filtered.length>0?filtered.slice(0,30).map(i=>`<div class="dropdown-item" onclick="selectStockistId('${i.id.replace(/'/g,"\\'")}','${(i.customer||'').replace(/'/g,"\\'")}')"><div class="item-name">🏪 ${i.id}</div><div class="item-detail">${i.customer||'Unknown'} ${i.mobile?'| 📱 '+i.mobile:''}</div></div>`).join(''):'<div class="dropdown-item" style="color:#999;">No stockist IDs found. Type a new one.</div>'}else{list.innerHTML=filtered.length>0?filtered.slice(0,50).map(i=>`<div class="dropdown-item" onclick="${onSelect}('${i.name.replace(/'/g,"\\'")}','${(i.mobile||'').replace(/'/g,"\\'")}','${(i.type||'').replace(/'/g,"\\'")}','${(i.detail||'').replace(/'/g,"\\'")}','${(i.source||'').replace(/'/g,"\\'")}')"><div class="item-name">${i.name}${i.source==='manual'?'<span class="manual-badge">⭐ MANUAL</span>':''}</div>${i.detail?`<div class="item-detail">${i.detail}</div>`:''}</div>`).join(''):'<div class="dropdown-item" style="color:#999;">No matches found</div>'}list.classList.add('show')}}

function selectStockistId(id){document.getElementById('stockist-id').value=id;document.getElementById('stockist-id-list').classList.remove('show');stockistFromDD=true;setTimeout(()=>{stockistFromDD=false},100)}

async function selectCustomer(name,mobile,type){document.getElementById('cust-name').value=name;document.getElementById('cust-mobile').value=mobile||'';document.getElementById('cust-list').classList.remove('show');resetUpdateMobile('bill');billFromDD=true;if(type){if(type==='stockist'){document.getElementById('show-mrp').checked=true;document.getElementById('show-sp').checked=true;document.getElementById('show-bp').checked=true}else if(type==='distributor'){document.getElementById('show-mrp').checked=true;document.getElementById('show-sp').checked=false;document.getElementById('show-bp').checked=true}else{document.getElementById('show-mrp').checked=true;document.getElementById('show-sp').checked=false;document.getElementById('show-bp').checked=false}}else{await determineCustomerType(name,mobile)}updatePriceDisplay();
const t=getCustomerType(document.getElementById('show-mrp').checked,document.getElementById('show-sp').checked,document.getElementById('show-bp').checked);
const si=document.getElementById('stockist-id');
if(t==='stockist'){
si.disabled=false;
si.placeholder='🏪 Stockist ID';
const fetchedId=await autoFetchStockistId(name,mobile);
if(fetchedId){si.value=fetchedId}
}else{
si.disabled=true;
si.value='';
si.placeholder='🏪 Stockist ID (Disabled)'
}
}

async function determineCustomerType(n,m){const bills=await DB.query('bills'),cm=(m||'').replace(/\D/g,''),cb=bills.filter(b=>b.cust_name===n&&(b.cust_mobile||'').replace(/\D/g,'')===cm);if(cb.length>0){const l=cb.sort((a,b)=>new Date(b.date)-new Date(a.date))[0];if(l.price_columns){const c=l.price_columns.split(',');document.getElementById('show-mrp').checked=c.includes('mrp');document.getElementById('show-sp').checked=c.includes('sp');document.getElementById('show-bp').checked=c.includes('bp')}}else{document.getElementById('show-mrp').checked=true;document.getElementById('show-sp').checked=true;document.getElementById('show-bp').checked=true}updatePriceDisplay()}

function selectReqCustomer(name,mobile,type){document.getElementById('req-cust').value=name;document.getElementById('req-mobile').value=mobile||'';document.getElementById('cust-list-req').classList.remove('show');resetUpdateMobile('req');reqFromDD=true;if(type)document.getElementById('req-customer-type').value=type;else findCustTypeReq(name,mobile)}
async function findCustTypeReq(n,m){const cs=await DB.query('customers'),cm=(m||'').replace(/\D/g,''),c=cs.find(x=>x.name===n&&(x.mobile||'').replace(/\D/g,'')===cm&&x.customer_type);if(c){document.getElementById('req-customer-type').value=c.customer_type;return}const bs=await DB.query('bills'),cb=bs.filter(b=>b.cust_name===n&&(b.cust_mobile||'').replace(/\D/g,'')===cm&&b.customer_type);if(cb.length>0){document.getElementById('req-customer-type').value=cb.sort((a,b)=>new Date(b.date)-new Date(a.date))[0].customer_type||'customer';return}const rs=await DB.query('requirements'),cr=rs.filter(r=>r.customer===n&&(r.mobile||'').replace(/\D/g,'')===cm&&r.customer_type);if(cr.length>0){document.getElementById('req-customer-type').value=cr.sort((a,b)=>new Date(b.date)-new Date(a.date))[0].customer_type||'customer';return}document.getElementById('req-customer-type').value='customer'}
function selectProduct(name){document.getElementById('prod-search').value='';document.getElementById('prod-list').classList.remove('show');const p=dropdownCache.products.find(x=>x.name===name);if(p){const mrp=parseFloat(p.detail.match(/MRP: ([\d.]+)/)[1])||0,sp=parseFloat(p.detail.match(/SP: ([\d.]+)/)[1])||0,bp=parseFloat(p.detail.match(/BP: ([\d.]+)/)[1])||0;const ex=cart.find(i=>i.item_name===p.name);if(ex)ex.qty+=1;else cart.push({item_name:p.name,mrp,sp,bp,qty:1});renderCart()}}
function selectReqProduct(name){document.getElementById('req-prod').value='';document.getElementById('prod-list-req').classList.remove('show');const p=dropdownCache.products.find(x=>x.name===name);if(p){const ex=reqList.find(i=>i.item_name===p.name);if(ex)ex.qty+=1;else reqList.push({item_name:p.name,qty:1});renderReq()}}
function handleUpdateMobileCheck(prefix,cb){const wrap=document.getElementById(`${prefix}-update-wrap`),mi=document.getElementById(`${prefix}-mobile`),ni=document.getElementById(prefix==='bill'?'cust-name':'req-cust');if(cb.checked){if(!ni.value.trim()){alert('⚠️ Enter customer name first.');cb.checked=false;return}if(confirm(`⚠️ UPDATE MOBILE\n\nUpdate for "${ni.value.trim()}"?`)){cb.checked=true;wrap.classList.add('active');mi.classList.add('update-mode');mi.focus();mi.select()}else{cb.checked=false;wrap.classList.remove('active');mi.classList.remove('update-mode')}}else{wrap.classList.remove('active');mi.classList.remove('update-mode')}}
function toggleUpdateMobile(p){const c=document.getElementById(`${p}-update-mobile`);c.checked=!c.checked;handleUpdateMobileCheck(p,c)}
function resetUpdateMobile(p){document.getElementById(`${p}-update-mobile`).checked=false;document.getElementById(`${p}-update-wrap`).classList.remove('active');document.getElementById(`${p}-mobile`).classList.remove('update-mode')}
function findCustomer(cs,n,m){const cm=(m||'').replace(/\D/g,'');let c=cs.find(x=>x.name===n&&(x.mobile||'').replace(/\D/g,'')===cm);if(c)return c;if(!cm){c=cs.find(x=>x.name===n&&!(x.mobile&&x.mobile.trim()));if(c)return c}return null}

