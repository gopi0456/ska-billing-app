rgin-bottom:8px;display:flex;align-items:center;gap:6px}.view-bill-header{background:linear-gradient(135deg,#1a1a2e,#0f3460);color:#fff;padding:15px;border-radius:10px;margin-bottom:15px;text-align:center}.view-bill-header .company-name{font-size:1.2rem;font-weight:700;letter-spacing:1px}.view-bill-header .company-sub{font-size:.75rem;color:#a8d8ea;margin-top:2px;letter-spacing:1px}.view-bill-header .bill-no{font-size:1.1rem;font-weight:700;margin-top:8px;background:rgba(255,255,255,.15);padding:5px 15px;border-radius:20px;display:inline-block}.view-bill-info{background:#f8f9fa;padding:12px;border-radius:8px;margin-bottom:12px}.view-bill-info-row{display:flex;justify-content:space-between;padding:6px 0;border-bottom:1px dashed #e0e0e0}.view-bill-info-row:last-child{border-bottom:none}.view-bill-info-row .label{color:#666;font-size:.85rem;font-weight:600}.view-bill-info-row .value{color:#1a1a2e;font-size:.9rem;font-weight:600}.view-bill-items{margin-top:12px}.view-bill-items table{font-size:.8rem;width:100%}.view-bill-items th{background:#0f3460;color:#fff;padding:8px 6px;font-size:.72rem}.view-bill-items td{padding:8px 6px;border-bottom:1px solid #f0f0f0}.view-bill-items tr:nth-child(even){background:#f8f9fa}.view-bill-total{background:linear-gradient(135deg,#e8f5e9,#c8e6c9);padding:12px;border-radius:8px;margin-top:12px;border:1px solid #a5d6a7}.view-bill-total-row{display:flex;justify-content:space-between;padding:4px 0}.view-bill-total-row.main{font-size:1.1rem;font-weight:700;color:#2e7d32;border-top:2px solid #4caf50;padding-top:8px;margin-top:4px}.view-bill-footer{text-align:center;margin-top:15px;padding:10px;background:#f8f9fa;border-radius:8px}.view-bill-footer .thank-you{font-style:italic;color:#666;font-size:.9rem}.view-bill-footer .visit-again{font-weight:700;color:#27ae60;font-size:1rem;margin-top:4px}.mgmt-cust-item{background:#fff;padding:12px;border-radius:10px;margin-bottom:8px;box-shadow:0 2px 8px rgba(0,0,0,.06);border:1px solid #f0f0f0;border-lef